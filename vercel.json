{
    "version": 2,
    "build": {
        "env": {
            "COMPOSER_FLAGS": "--no-dev --optimize-autoloader"
        }
    },
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.6.2",
            "excludeFiles": "{node_modules/**,tests/**,storage/framework/**,storage/logs/**,.git/**}"
        }
    },
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}